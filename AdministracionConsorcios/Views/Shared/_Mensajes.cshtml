@if (TempData["Exito"] != null)
{
    <div class="max-w-4xl mx-auto mt-3 px-4">
        <div class="bg-green-100 text-green-700 p-3 rounded">
            @TempData["Exito"]
        </div>
    </div>
}
@if (TempData["Error"] != null)
{
    <div class="max-w-4xl mx-auto mt-3 px-4">
        <div class="bg-red-100 text-red-700 p-3 rounded">
            @TempData["Error"]
        </div>
    </div>
}