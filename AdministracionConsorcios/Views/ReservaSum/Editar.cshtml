@using DTOs.ViewModels
@using Model
@model ReservaSumViewModel
@{
    ViewData["Title"] = "Editar Reserva";
    Layout = "_LogeadoLayout";
}

<section class="flex items-center justify-center p-7 flex-1 bg-gray-50">
    <div class="bg-white shadow-md rounded-xl p-7 w-full max-w-4xl">
        <h1 class="text-2xl font-semibold text-gray-800 mb-6 text-center">Editar Reserva — @Model.NombreSum</h1>

        <div class="overflow-x-auto">
            <div class="max-w-6xl mx-auto p-6 bg-white shadow-md rounded-md">

                <form class="md:col-span-2 space-y-4"
                      asp-controller="ReservaSum"
                      asp-action="EditarReserva"
                      method="post">

                    <input type="hidden" asp-for="Id" />
                    <input type="hidden" asp-for="IdSum" />
                    <input type="hidden" asp-for="NombreSum" />
                    <input type="hidden" asp-for="IdUsuario" />

                    <div>
                        <label for="nombreSum" class="block text-gray-700 font-medium mb-2">Sum</label>
                        <input type="text"
                               id="nombreSum"
                               value="@Model.NombreSum"
                               readonly
                               class="w-full px-3 py-2 border border-gray-300 rounded-md bg-gray-100 focus:outline-none" />
                    </div>

                    <div>
                        <label for="nombreUsuario" class="block text-gray-700 font-medium mb-2">Usuario</label>
                        <input type="text"
                               id="nombreUsuario"
                               value="@Model.NombreUsuario"
                               readonly
                               class="w-full px-3 py-2 border border-gray-300 rounded-md bg-gray-100 focus:outline-none" />
                    </div>

                    <div>
                        <label for="fechaReserva" class="block text-gray-700 font-medium mb-2">Fecha de Reserva</label>
                        <input type="date"
                               id="fechaReserva"
                               asp-for="FechaReserva"
                               class="w-full px-3 py-2 border border-gray-300 rounded-md focus:outline-none focus:ring-2 focus:ring-blue-500" />
                        <span asp-validation-for="FechaReserva" class="text-red-500"></span>
                    </div>

                    <div>
                        <label for="turno" class="block text-gray-700 font-medium mb-2">Turno</label>
                        <select id="turno"
                                asp-for="Turno"
                                class="w-full px-3 py-2 border border-gray-300 rounded-md focus:outline-none focus:ring-2 focus:ring-blue-500">
                            <option value="">Seleccione un turno</option>
                            <option value="0">Día</option>
                            <option value="1">Noche</option>
                        </select>
                        <span asp-validation-for="Turno" class="text-red-500"></span>
                    </div>

                    <div>
                        <label for="comentarios" class="block text-gray-700 font-medium mb-2">Comentarios</label>
                        <textarea id="comentarios"
                                  asp-for="Comentarios"
                                  rows="3"
                                  class="w-full px-3 py-2 border border-gray-300 rounded-md focus:outline-none focus:ring-2 focus:ring-blue-500"></textarea>
                        <span asp-validation-for="Comentarios" class="text-red-500"></span>
                    </div>

                    <div class="flex items-center gap-3 rounded-md border border-gray-200 px-4 py-3 bg-gray-50">
                        <input type="checkbox"
                               id="entregoCorrectamente"
                               asp-for="EntregoCorrectamente"
                               class="h-4 w-4 rounded border-gray-300 text-blue-600 focus:ring-blue-500" />
                        <label for="entregoCorrectamente" class="text-gray-700 font-medium">
                            ¿Entregó Correctamente?
                        </label>
                    </div>

                    <div class="flex flex-row gap-4 mt-4">
                        <button type="submit"
                                class="flex-1 bg-blue-600 text-white font-bold py-2 px-4 rounded-md hover:bg-blue-700 transition-colors">
                            Guardar
                        </button>
                        <a asp-controller="ReservaSum"
                           asp-action="Index"
                           asp-route-id="@Model.IdSum"
                           class="flex-1">
                            <button type="button" class="w-full bg-gray-500 text-white font-bold py-2 px-4 rounded-md hover:bg-gray-600 transition-colors">
                                Cancelar
                            </button>
                        </a>
                        <a asp-controller="ReservaSum"
                           asp-action="Eliminar"
                           asp-route-id="@Model.Id"
                           class="flex-1">
                            <button type="button" class="w-full bg-red-600 text-white font-bold py-2 px-4 rounded-md hover:bg-red-700 transition-colors">
                                Eliminar Reserva
                            </button>
                        </a>
                    </div>

                </form>
            </div>
        </div>
    </div>
</section>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
