@using DTOs.ViewModels
@model NotificacionViewModel
@{
    ViewData["Title"] = "Eliminar Notificación";
    Layout = "_LogeadoLayout";
}

<section class="flex items-center justify-center p-7 flex-1 bg-gray-50">
    <div class="bg-white shadow-md rounded-xl p-7 w-full max-w-4xl">
        <h1 class="text-2xl font-semibold text-gray-800 mb-6 text-center">
            ¿Está seguro que desea eliminar esta notificación?
        </h1>

        <div class="overflow-x-auto">
            <div class="max-w-6xl mx-auto p-6 bg-white shadow-md rounded-md space-y-4">

                <div>
                    <label class="block text-gray-700 font-medium mb-2">Título</label>
                    <input type="text"
                           value="@Model.Titulo"
                           readonly
                           class="w-full px-3 py-2 border border-gray-300 rounded-md bg-gray-100 focus:outline-none" />
                </div>

                <div>
                    <label class="block text-gray-700 font-medium mb-2">Descripción</label>
                    <textarea readonly
                              rows="4"
                              class="w-full px-3 py-2 border border-gray-300 rounded-md bg-gray-100 focus:outline-none">@Model.Descripcion</textarea>
                </div>

                <div>
                    <label class="block text-gray-700 font-medium mb-2">Fecha Creación</label>
                    <input type="text"
                           value="@Model.FechaCreacion.ToString("dd/MM/yyyy HH:mm")"
                           readonly
                           class="w-full px-3 py-2 border border-gray-300 rounded-md bg-gray-100 focus:outline-none" />
                </div>

                <form asp-controller="Notificacion" asp-action="EliminarNotificacion" method="post">
                    <input type="hidden" name="id" value="@Model.Id" />
                    <input type="hidden" name="idConsorcio" value="@Model.IdConsorcio" />

                    <div class="flex flex-row gap-4 mt-4 justify-center">
                        <button type="submit"
                                class="flex-1 bg-red-600 text-white font-bold py-2 px-4 rounded-md hover:bg-red-700 transition-colors">
                            Eliminar
                        </button>
                        <a asp-controller="Notificacion"
                           asp-action="Index"
                           asp-route-id="@Model.IdConsorcio"
                           class="flex-1">
                            <button type="button" class="w-full bg-gray-500 text-white font-bold py-2 px-4 rounded-md hover:bg-gray-600 transition-colors">
                                Cancelar
                            </button>
                        </a>
                    </div>
                </form>
            </div>
        </div>
    </div>
</section>
